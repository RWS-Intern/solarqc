rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role()   { return userDoc().role; }
    function active() { return userDoc().active == true; }
    function signedIn() { return request.auth != null; }
    function touched()  { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Fields ONLY an approver may ever write. inspectorSignOff/
    // customerSignOff are here ONLY so a reject can null them — see the
    // update rule below, which restricts that to null specifically.
    function approverFields() {
      return ['verdict', 'verdictNote', 'conditions', 'rejectionReason',
              'reworkPointIds', 'approverComments', 'approverSignOff',
              'reviewedAt', 'completedAt', 'status', 'updatedAt',
              'reworkRound', 'inspectorSignOff', 'customerSignOff'];
    }
    // Fields ONLY an inspector may write
    function inspectorFields() {
      return ['answers', 'tally', 'location', 'locationAt',
              'inspectorSignOff', 'customerSignOff', 'submittedAt',
              'status', 'updatedAt'];
    }
    // Fields admin/qc_manager may write — assignment and lifecycle only,
    // never the checklist content or the verdict
    function managerFields() {
      return ['inspectorUid', 'inspectorName', 'inspectorCode',
               'inspectorMobile', 'approverUid', 'approverName', 'status',
               'scheduledDate', 'dueDate', 'archived', 'archivedAt',
               'cancelReason', 'updatedAt'];
    }
    // Fields the certificate-generation action writes (Phase 8). Kept out
    // of managerFields() deliberately — that rule has no status
    // precondition and no content validation, so leaving reportUrl/
    // reportedAt there (as they were before this phase) would make the
    // narrower rule below pointless: admin/qc_manager could just write
    // garbage through the old permissive path instead.
    function reportFields() {
      return ['reportUrl', 'reportedAt', 'updatedAt'];
    }

    match /qcJobs/{jobId} {
      allow read: if signedIn() && active() && (
           role() in ['admin', 'qc_manager', 'approver', 'viewer']
        || (role() == 'qc_inspector' && resource.data.inspectorUid == request.auth.uid)
      );

      allow create, delete: if signedIn() && active() && role() == 'admin';

      // Inspector: own job, only in a fillable state, only inspector
      // fields, and status may only move in_progress -> pending_approval
      // (or stay put on a draft save).
      allow update: if signedIn() && active()
        && role() == 'qc_inspector'
        && resource.data.inspectorUid == request.auth.uid
        && resource.data.status in ['assigned', 'in_progress', 'rework']
        && touched().hasOnly(inspectorFields())
        && (!touched().hasAny(['status'])
            || request.resource.data.status in ['in_progress', 'pending_approval']);

      // Approver (or admin — roles.ts already grants admin the
      // approveJobs capability, and plan §5.1 lists both roles for
      // /approvals): only jobs awaiting review, only approver fields, and
      // a verdict must be typed — no silent approvals, no reason-less
      // rejects, no conditional verdict without conditions, no reject
      // without at least one flagged rework point, and reworkRound can
      // only ever advance by exactly one on a reject (stops it being
      // bumped further, which would corrupt the rounds/{n} numbering).
      // inspectorSignOff/customerSignOff may only ever be nulled here,
      // never set to real signature data — clearing a stale round-1
      // signature off the live doc on reject, nothing else.
      allow update: if signedIn() && active()
        && role() in ['approver', 'admin']
        && resource.data.status == 'pending_approval'
        && touched().hasOnly(approverFields())
        && request.resource.data.status in ['approved', 'rework']
        && request.resource.data.verdictNote is string
        && request.resource.data.verdictNote.size() > 0
        && (request.resource.data.verdict != 'conditional'
            || (request.resource.data.conditions is string
                && request.resource.data.conditions.size() > 0))
        && (!touched().hasAny(['inspectorSignOff']) || request.resource.data.inspectorSignOff == null)
        && (!touched().hasAny(['customerSignOff'])  || request.resource.data.customerSignOff  == null)
        && (request.resource.data.status != 'rework'
            || (request.resource.data.rejectionReason is string
                && request.resource.data.rejectionReason.size() > 0
                && request.resource.data.reworkPointIds is list
                && request.resource.data.reworkPointIds.size() > 0
                && request.resource.data.reworkRound == resource.data.reworkRound + 1));

      // Admin / qc_manager: assignment and lifecycle fields only — never
      // the checklist, never the verdict, and never a status transition
      // that belongs to the inspector/approver flow. managerFields()
      // includes 'status' for assignment purposes only (unassigned <->
      // assigned); anything else (approved, rework, in_progress,
      // pending_approval) must go through the inspector/approver rules
      // above, which is what actually enforces a typed verdict and a
      // rejection reason. Without this, admin/qc_manager could write
      // status: 'approved' directly with no verdict at all.
      allow update: if signedIn() && active()
        && role() in ['admin', 'qc_manager']
        && touched().hasOnly(managerFields())
        && (!touched().hasAny(['status'])
            || request.resource.data.status in ['unassigned', 'assigned']);

      // Certificate generation (Phase 8) — admin/qc_manager only. Note this
      // is deliberately narrower than roles.ts's full viewReports set,
      // which also includes 'viewer': viewer has no write capability
      // anywhere else in this app, and generating a certificate is a
      // write action, not a view. Gated on the job already being
      // approved — you can't certify what hasn't passed. No precondition
      // against reportUrl already being set: regenerating a certificate
      // (a branding fix, whatever) is a reasonable thing to allow, not a
      // one-shot action.
      allow update: if signedIn() && active()
        && role() in ['admin', 'qc_manager']
        && resource.data.status == 'approved'
        && touched().hasOnly(reportFields())
        && request.resource.data.reportUrl is string
        && request.resource.data.reportUrl.size() > 0;

      // Audit trail: append-only, forever — including for admin.
      match /events/{eventId} {
        allow read:   if signedIn() && active();
        allow create: if signedIn() && active()
                      && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Round freeze — written once, by the approver, on rejection.
      match /rounds/{roundId} {
        allow read:   if signedIn() && active();
        allow create: if signedIn() && active() && role() in ['approver', 'admin'];
        allow update, delete: if false;
      }
    }

    // Template + config: admin only. No client counter writes anywhere —
    // this is what closes the hole in plan §4.3 where any field engineer
    // could rewrite the survey template or overwrite superAdminUid.
    match /appConfig/{docId} {
      allow read:  if signedIn();
      allow write: if signedIn() && active() && role() == 'admin';
    }

    match /users/{uid} {
      allow read:   if signedIn() && (request.auth.uid == uid
                       || role() in ['admin', 'qc_manager']);
      // Self-create fixes the signup deadlock in plan §11.6 — a brand-new
      // user has no doc yet, so role()/active() would throw. Admin-create
      // restores the old app's admin-can-create-any-user's-doc behavior,
      // needed by /team's "Add User" flow (useUserActions.createUser()),
      // which writes the new user's doc from the admin's own session.
      allow create: if signedIn() && (
           request.auth.uid == uid
        || (active() && role() == 'admin')
      );
      allow update: if signedIn() && (
           (active() && role() == 'admin')
        || (request.auth.uid == uid
            && touched().hasOnly(['photoURL', 'fcmToken', 'fcmTokenUpdatedAt']))
      );
      allow delete: if false;
    }
  }
}
