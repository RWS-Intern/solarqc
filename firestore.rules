rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()  { return request.auth != null; }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin()        { return isAuth() && userRole() == 'admin'; }
    function isField()        { return isAuth() && userRole() == 'field'; }
    function isProposal()     { return isAuth() && userRole() == 'proposal'; }
    function isBackend()      { return isAuth() && userRole() == 'backend'; }
    function isLogistics()      { return isAuth() && userRole() == 'logistics'; }
    function isInstallation()   { return isAuth() && userRole() == 'installation'; }
    function isViewOnly()       { return isAuth() && userRole() == 'view_only'; }
    function isBackendManager() { return isAuth() && userRole() == 'backend_manager'; }

    match /users/{uid} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /appConfig/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin()
                   || isField()
                   || isProposal()
                   || isBackend();
    }

    match /invites/{inviteId} {
      // Read allowed unauthenticated (signup flow)
      // OR authenticated (admin management)
      // but only pending invites for unauthenticated
      allow read:  if isAuth()
                   || resource.data.status == 'pending';
      allow write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read:   if isAdmin()
                    || isViewOnly()
                    || isBackendManager()
                    || (isField()        && resource.data.assignedTo         == request.auth.uid)
                    || (isProposal()     && (resource.data.pipelineStage     == 'proposal'
                                         || resource.data.proposalAssignedTo == request.auth.uid))
                    || (isBackend()      && resource.data.backendAssignedTo  == request.auth.uid)
                    || (isLogistics()    && resource.data.pipelineStage      == 'logistics')
                    || (isInstallation() && resource.data.pipelineStage      == 'installation');

      allow create: if isAdmin();

      allow update: if isAdmin()
                    || (isField()        && resource.data.assignedTo             == request.auth.uid)
                    || (isProposal()     && resource.data.proposalAssignedTo     == request.auth.uid)
                    || (isBackend()      && resource.data.backendAssignedTo      == request.auth.uid)
                    || (isLogistics()    && resource.data.pipelineStage          == 'logistics')
                    || (isInstallation() && resource.data.pipelineStage          == 'installation');

      allow delete: if isAdmin();

      match /updates/{updateId} {
        allow read:   if isAdmin()
                      || isViewOnly()
                      || isBackendManager()
                      || (isField() && get(/databases/$(database)/documents/tasks/$(taskId)).data.assignedTo == request.auth.uid);
        allow create: if isAdmin()
                      || (isField() && get(/databases/$(database)/documents/tasks/$(taskId)).data.assignedTo == request.auth.uid);
        allow update: if false;
        allow delete: if false;
      }

      match /stages/{stageId} {
        allow read:   if isAdmin()
                      || isViewOnly()
                      || isBackendManager()
                      || (isField()        && get(/databases/$(database)/documents/tasks/$(taskId)).data.assignedTo         == request.auth.uid)
                      || (isProposal()     && (get(/databases/$(database)/documents/tasks/$(taskId)).data.pipelineStage     == 'proposal'
                                           || get(/databases/$(database)/documents/tasks/$(taskId)).data.proposalAssignedTo == request.auth.uid))
                      || (isBackend()      && get(/databases/$(database)/documents/tasks/$(taskId)).data.backendAssignedTo  == request.auth.uid)
                      || (isLogistics()    && get(/databases/$(database)/documents/tasks/$(taskId)).data.pipelineStage      == 'logistics')
                      || (isInstallation() && get(/databases/$(database)/documents/tasks/$(taskId)).data.pipelineStage      == 'installation');

        allow create: if isAdmin()
                      || (isField()        && get(/databases/$(database)/documents/tasks/$(taskId)).data.assignedTo             == request.auth.uid)
                      || (isProposal()     && get(/databases/$(database)/documents/tasks/$(taskId)).data.proposalAssignedTo     == request.auth.uid)
                      || (isBackend()      && get(/databases/$(database)/documents/tasks/$(taskId)).data.backendAssignedTo      == request.auth.uid)
                      || (isLogistics()    && get(/databases/$(database)/documents/tasks/$(taskId)).data.pipelineStage          == 'logistics')
                      || (isInstallation() && get(/databases/$(database)/documents/tasks/$(taskId)).data.pipelineStage          == 'installation');

        allow update: if isAdmin()
                      || (isField()        && get(/databases/$(database)/documents/tasks/$(taskId)).data.assignedTo             == request.auth.uid)
                      || (isProposal()     && get(/databases/$(database)/documents/tasks/$(taskId)).data.proposalAssignedTo     == request.auth.uid)
                      || (isBackend()      && get(/databases/$(database)/documents/tasks/$(taskId)).data.backendAssignedTo      == request.auth.uid)
                      || (isLogistics()    && get(/databases/$(database)/documents/tasks/$(taskId)).data.pipelineStage          == 'logistics')
                      || (isInstallation() && get(/databases/$(database)/documents/tasks/$(taskId)).data.pipelineStage          == 'installation');

        allow delete: if isAdmin();
      }
    }

    match /errorLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAuth();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
